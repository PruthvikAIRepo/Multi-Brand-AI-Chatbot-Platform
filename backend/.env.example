# Database
DATABASE_URL=postgresql+asyncpg://postgres:12345@localhost:5432/chatbot_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Claude API (from client)
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514

# Embeddings (from client)
EMBEDDINGS_API_KEY=pa-xxxxx
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_MODEL=voyage-3

# S3 (from client)
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_S3_BUCKET=skincare-chatbot
AWS_REGION=us-east-1

# Encryption (generate a 32-byte key for AES-256)
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# reCAPTCHA
RECAPTCHA_SECRET_KEY=xxxxx

# Rate Limiting
RATE_LIMIT_PER_IP=60

# Server
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
