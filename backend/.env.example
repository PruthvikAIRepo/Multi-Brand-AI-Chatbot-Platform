# Copy to .env for local dev. In production set these via the platform / Secret
# Manager — NEVER commit real values. See docs/DEPLOY_GCP.md.

# --- Core (REQUIRED in production; app refuses to boot on defaults/empty) ---
ENVIRONMENT=development                 # set to "production" when hosting
SECRET_KEY=your-secret-key-change-in-production     # JWT signing — strong random in prod
ENCRYPTION_KEY=your-32-byte-encryption-key-here     # AES-256-GCM at-rest key — strong random in prod
# ENCRYPTION_KEYS_RETIRED=              # comma-separated old keys during rotation (decrypt-only)

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:12345@localhost:5432/chatbot_db
# Cloud Run + Cloud SQL form:
# postgresql+asyncpg://USER:PASS@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE

# --- Redis (optional for login; auth limiter fails open if down) ---
REDIS_URL=redis://localhost:6379/0

# --- First Super Admin (used once by `python -m app.seed`) ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Auth tuning ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_IP=60
AUTH_RATE_LIMIT_PER_IP=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- CORS (the admin panel / frontend origin) ---
CORS_ORIGINS=http://localhost:3000

# --- Email (password reset + invites; no-op if SMTP_HOST unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@chatbot.com
SMTP_USE_TLS=true
FRONTEND_URL=http://localhost:3000

# --- AI / embeddings / storage (from client; not needed for the login flow) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-4-20250514
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_API_KEY=pa-xxxxx
EMBEDDINGS_MODEL=voyage-3
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_S3_BUCKET=skincare-chatbot
AWS_REGION=us-east-1

# --- Meta / reCAPTCHA (Phase 2 channels) ---
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=chatbot_webhook_verify_2026
RECAPTCHA_SECRET_KEY=xxxxx
